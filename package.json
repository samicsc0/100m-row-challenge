{
  "name": "100m-row-challenge",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint .",
    "format": "prettier --write .",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:wipe": "docker compose down -v",
    "db:ingest": "cat ./apps/data-100m.csv | docker exec -i 100m_postgres psql -U postgres -d events_db -c \"\\copy events(project_id, event_name, user_id, payload, created_at) FROM STDIN WITH (FORMAT csv, HEADER true);\"",
    "db:generate": "bun --filter api db:generate",
    "db:migrate": "bun --filter api db:migrate",
    "db:studio": "bun --filter api db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5"
  }
}
